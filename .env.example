# MeetOps production environment — copy to .env on the VPS and fill in secrets
# cp .env.example .env
#
# This file is read by docker compose (env_file + variable interpolation)
# and by the scripts in ./scripts.

# =====================================================================
# Deploy-side (ECR pull) — used by compose interpolation and scripts
# =====================================================================
AWS_REGION=us-east-1
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=
ECR_API_REPOSITORY=meetops/api
ECR_WORKER_REPOSITORY=meetops/worker
ECR_WEB_REPOSITORY=meetops/web
# Tag to deploy: "latest" or a 12-char commit SHA from CI
IMAGE_TAG=latest

# =====================================================================
# Application
# =====================================================================

# --- Server ---
MEETOPS_ENV=production
MEETOPS_API_HOST=0.0.0.0
MEETOPS_API_PORT=8000
# Tailscale serve terminates HTTPS on the tailnet name and proxies to web (:3000).
# Replace <tailnet> with your tailnet suffix, e.g. https://aws-meetops-vps.tail1234.ts.net
MEETOPS_APP_BASE_URL=https://aws-meetops-vps.<tailnet>.ts.net
MEETOPS_PUBLIC_API_URL=https://aws-meetops-vps.<tailnet>.ts.net
MEETOPS_CORS_ORIGINS=https://aws-meetops-vps.<tailnet>.ts.net

# --- Database (AWS RDS, required) ---
# Option A (preferred): resolve credentials at startup from Secrets Manager via
# the instance role — no password in this file. Overrides DATABASE_URL.
MEETOPS_DATABASE_SECRET_ARN=
MEETOPS_DATABASE_HOST=
MEETOPS_DATABASE_PORT=
MEETOPS_DATABASE_NAME=

# Option B: full URL with inline (URL-encoded) password; unset the SECRET_ARN above to use this.
# DATABASE_URL=postgresql+asyncpg://meetops:<password>@<rds-endpoint>:5432/meetops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Auth ---
MEETOPS_SESSION_TTL_SECS=2592000
MEETOPS_SESSION_COOKIE_NAME=meetops_session
MEETOPS_SESSION_COOKIE_SAMESITE=lax
MEETOPS_REQUIRE_EMAIL_VERIFICATION=true
MEETOPS_EMAIL_VERIFY_TTL_SECS=86400
MEETOPS_PASSWORD_RESET_TTL_SECS=3600
MEETOPS_AUTH_RATE_LIMIT=10/minute

# --- Email (Resend) ---
RESEND_API_KEY=
MEETOPS_EMAIL_FROM=noreply@example.com
MEETOPS_EMAIL_FROM_NAME=MeetOps

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in the Google Cloud console
GOOGLE_REDIRECT_URI=https://aws-meetops-vps.<tailnet>.ts.net/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=https://aws-meetops-vps.<tailnet>.ts.net/app/calendars
MEETOPS_CALENDAR_SYNC_INTERVAL_SECS=300

# --- Crypto (required in production) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEETOPS_TOKEN_ENCRYPTION_KEY=
# Note: MEETOPS_ALLOW_PLAINTEXT_TOKENS must never be set in production.

# --- S3 (required in production) ---
S3_BUCKET=
S3_PREFIX=recordings
# Leave the keys empty if the VPS has an instance role with S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEETOPS_PRESIGNED_URL_TTL_SECS=3600
MEETOPS_DELETE_LOCAL_AFTER_UPLOAD=true
MEETOPS_STAGING_TTL_DAYS=7

# --- Bot ---
MEETOPS_BOT_DISPLAY_NAME=MeetOps Notetaker
MEETOPS_BOT_CONCURRENCY=2
MEETOPS_BOT_JOIN_LEAD_TIME_SECS=60
MEETOPS_BOT_ADMISSION_TIMEOUT_SECS=300
MEETOPS_BOT_SCHEDULER_POLL_SECS=15
MEETOPS_BOT_SOLO_LEAVE_SECS=300
MEETOPS_BOT_ADHOC_DURATION_SECS=7200
MEETOPS_PATCHRIGHT_CHANNEL=bundled
# Leave false in production — auto-accept increases bot detectability
MEETOPS_USE_TAB_CAPTURE_AUTO_ACCEPT=false

# --- AI (OpenAI) — worker skips AI if unset ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Observability ---
MEETOPS_LOG_LEVEL=INFO
MEETOPS_LOG_JSON=true
