# MeetOps environment — copy to .env and fill in secrets
# cp .env.example .env

# --- Server ---
MEETOPS_ENV=development
MEETOPS_API_HOST=0.0.0.0
MEETOPS_API_PORT=8000
MEETOPS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MEETOPS_APP_BASE_URL=http://localhost:5173
MEETOPS_PUBLIC_API_URL=http://localhost:8000

# --- Database (required) ---
DATABASE_URL=postgresql+asyncpg://meetops:meetops@localhost:5433/meetops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Auth ---
MEETOPS_SESSION_TTL_SECS=2592000
MEETOPS_SESSION_COOKIE_NAME=meetops_session
# MEETOPS_SESSION_COOKIE_SECURE defaults to true in production
MEETOPS_SESSION_COOKIE_SAMESITE=lax
MEETOPS_REQUIRE_EMAIL_VERIFICATION=true
# For local smoke tests without Resend, set to false (links are still logged when Resend unset)
MEETOPS_EMAIL_VERIFY_TTL_SECS=86400
MEETOPS_PASSWORD_RESET_TTL_SECS=3600
MEETOPS_AUTH_RATE_LIMIT=10/minute

# --- Email (Resend) — optional in development (links logged at INFO) ---
# RESEND_API_KEY=
# MEETOPS_EMAIL_FROM=noreply@example.com
MEETOPS_EMAIL_FROM_NAME=MeetOps

# --- Google Calendar OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173/app/calendars
MEETOPS_CALENDAR_SYNC_INTERVAL_SECS=300

# --- Crypto ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MEETOPS_TOKEN_ENCRYPTION_KEY=
# Dev only — never in production:
MEETOPS_ALLOW_PLAINTEXT_TOKENS=1

# --- S3 ---
# S3_BUCKET=
S3_PREFIX=recordings
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MEETOPS_PRESIGNED_URL_TTL_SECS=3600
MEETOPS_DELETE_LOCAL_AFTER_UPLOAD=true
MEETOPS_DATA_DIR=./data
MEETOPS_STAGING_TTL_DAYS=7

# --- Bot ---
MEETOPS_BOT_DISPLAY_NAME=MeetOps Notetaker
MEETOPS_BOT_CONCURRENCY=2
# MEETOPS_BOT_PROFILES_DIR=./data/chrome-profiles
MEETOPS_BOT_JOIN_LEAD_TIME_SECS=60
MEETOPS_BOT_ADMISSION_TIMEOUT_SECS=300
MEETOPS_BOT_SCHEDULER_POLL_SECS=15
MEETOPS_BOT_SOLO_LEAVE_SECS=300
MEETOPS_BOT_ADHOC_DURATION_SECS=7200
# MEETOPS_BOT_X11_DISPLAY=:99
# Password for the debug worker noVNC (bot bootstrap); unset = no password
# MEETOPS_VNC_PASSWORD=
# MEETOPS_BROWSER_PROXY=
MEETOPS_PATCHRIGHT_CHANNEL=bundled
MEETOPS_USE_TAB_CAPTURE_AUTO_ACCEPT=false

# --- Transcription ---
# auto = Deepgram when DEEPGRAM_API_KEY is set, else OpenAI Whisper
MEETOPS_TRANSCRIBE_PROVIDER=auto
# DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest

# --- AI (OpenAI) — notes / LLM; also Whisper fallback when Deepgram unset ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Observability ---
MEETOPS_LOG_LEVEL=INFO
MEETOPS_LOG_JSON=false
