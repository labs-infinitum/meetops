{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["proto:generate"],
      "outputs": ["dist/**", "target/release/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "cache": false
    },
    "proto:generate": {
      "cache": false,
      "outputs": ["src/gen/**"]
    },
    "db:reset": {
      "cache": false
    }
  }
}
