[server]
host = "127.0.0.1"
port = 8080

[grpc]
host = "127.0.0.1"
port = 50051
allow_origin = "http://localhost:5173"

[auth]
session_ttl_secs = 2592000

[logging]
# Used when RUST_LOG is unset. Env override: GMR_LOGGING__FILTER
filter = "info,google_meeting_recorder=debug,tower_http=debug,tonic=info"
log_file = true
log_line = true

[storage]
data_dir = "./data"

[storage.recordings]
backend = "s3"
delete_local_after_upload = true

[storage.recordings.s3]
bucket = ""
prefix = "recordings"
# region defaults to AWS_REGION env when unset
presigned_url_ttl_secs = 3600

[google]
client_id = ""
client_secret = ""
redirect_uri = "http://localhost:8080/auth/google/callback"
frontend_redirect_url = "http://localhost:5173/app/calendars"
calendar_sync_interval_secs = 300

[bot]
display_name = "AI Notetaker"
# Use Google Chrome (not Chromium/Brave) for Meet + getDisplayMedia automation.
# Optional Linux managed policies: copy contrib/google-chrome-managed-policy.json.example to
#   /etc/opt/chrome/policies/managed/google-meeting-recorder.json
# then verify at chrome://policy (may still need the tab-capture Allow prompt).
chromium_path = "/usr/bin/google-chrome-stable"
# Relative paths are resolved from the process cwd; prefer an absolute path in production.
# Linux: Chrome uses --password-store=basic so Google sign-in survives Xvfb/desktop logout.
# Re-run `cargo run -- profile` once after upgrading if Meet asks you to sign in again.
chrome_user_data_dir = "./data/chrome-profile"
# Linux X11 (optional). Unset = auto-discover a working display or start Xvfb on :10+.
# Pin a display: x11_display = ":1"
# Disable auto Xvfb: x11_auto_virtual = false
# Disable auto openbox (xdotool): x11_start_openbox = false
# x11_display = ":1"
# Linux: pale-blue chroma heuristic on PNG first (`allow_button_detect`); grayscale template refines pose if blob misses.
allow_button_template_png = "./allow-button-template.png"
# After getDisplayMedia: 3s wait; grab Chrome PNG, blob + optional template correlates Allow, xdotool --window clicks.
# Uses the spawned browser's OS pid (`xdotool search --pid`) so other Chrome windows on the same DISPLAY are ignored when possible.
# Requires: xdotool + one of ImageMagick (magick/import), maim, or ffmpeg with x11grab.
# Saves PNGs under data/recordings/<run>/tab-capture-screenshots/.
join_lead_time_secs = 60
admission_timeout_secs = 300
# How often the server looks for meetings to auto-record (tab capture → data/recordings/run-<id>/).
scheduler_poll_interval_secs = 15

[groq]
api_key_env = "GROQ_API_KEY"
transcription_model = "whisper-large-v3-turbo"
summarization_model = "qwen3-32b-131k"
