# Copy to apps/backend/.env before `docker compose up`.
# Register the OAuth redirect URI in Google Cloud Console:
#   http://localhost:8080/auth/google/callback

GMR_GOOGLE__CLIENT_ID=
GMR_GOOGLE__CLIENT_SECRET=

# Encrypt calendar OAuth tokens at rest (openssl rand -base64 32)
# GMR_STORAGE__TOKEN_ENCRYPTION_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=recordings

GROQ_API_KEY=
