# Copy to apps/backend/.env and fill in values.

RUST_LOG=info,google_meeting_recorder=debug,tower_http=debug,tonic=info,chromiumoxide::handler=error

GMR_GOOGLE__CLIENT_ID=
GMR_GOOGLE__CLIENT_SECRET=
GMR_GOOGLE__REDIRECT_URI=http://localhost:8080/auth/google/callback
# ^ Google OAuth callback (Rust HTTP server on :8080 — not the React UI)
GMR_GOOGLE__FRONTEND_REDIRECT_URL=http://localhost:5173/app/calendars
# ^ Where the browser lands after OAuth (Vite dev :5173, Docker frontend :3000)

# gRPC CORS — comma-separated browser origins allowed to call grpc-web
# GMR_GRPC__ALLOW_ORIGIN=http://localhost:5173,http://localhost:3000

# Encrypt calendar OAuth tokens at rest (base64-encoded 32-byte key). Generate with:
#   openssl rand -base64 32
# GMR_STORAGE__TOKEN_ENCRYPTION_KEY=

# PostgreSQL (required). Example for local docker compose postgres service:
# DATABASE_URL=postgres://notetaker:notetaker@localhost:5432/notetaker
GMR_DATABASE__SECRET_ARN=
GMR_DATABASE__HOST=
GMR_DATABASE__PORT=5432
GMR_DATABASE__DBNAME=

GROQ_API_KEY=

# Resend transactional email (verification + password reset)
RESEND_API_KEY=
# GMR_EMAIL__FROM_EMAIL=onboarding@yourdomain.com

# Recording storage (S3). When S3_BUCKET is set, backend auto-enables S3 uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

S3_BUCKET=
S3_PREFIX=recordings

GMR_STORAGE__TOKEN_ENCRYPTION_KEY=
