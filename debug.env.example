# Copy to repo-root .env (or export before docker compose) for backend-debug.
# Your laptop RustDesk client must use the same ID server + key.

RUSTDESK_PASSWORD=ChooseAStrongPassword
DEBUG_WAIT_SECS=15

# --- Self-hosted RustDesk server (hbbs / hbbr) ---
# ID server = hbbs host or IP (port optional, default 21116)
RUSTDESK_ID_SERVER=rustdesk.example.com
# Relay = hbbr host (optional; defaults to RUSTDESK_ID_SERVER)
# RUSTDESK_RELAY_SERVER=rustdesk.example.com
# Public key from hbbs data dir: id_ed25519.pub (no quotes around the value)
RUSTDESK_KEY=

# RustDesk Server Pro only (optional)
# RUSTDESK_API_SERVER=https://rustdesk.example.com

# Alternative: paste the base64 string from Settings → Network → Export Server Config
# on a client already configured for your server (overrides the vars above).
# RUSTDESK_CONFIG=
