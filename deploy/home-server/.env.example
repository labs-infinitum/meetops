# MeetOps home-server environment. scripts/setup.sh copies this to .env and fills the generated
# secrets (POSTGRES_PASSWORD, MEETOPS_TOKEN_ENCRYPTION_KEY, MEETOPS_VNC_PASSWORD) and the
# tailnet URLs. Add API keys with scripts/set-secret.sh NAME (hidden prompt) instead of an editor
# if you prefer they never show on screen.

# --- Server ---
MEETOPS_ENV=production
MEETOPS_API_HOST=0.0.0.0
MEETOPS_API_PORT=8000
# The app's tailnet address (tailscale serve terminates HTTPS there), e.g. https://meetops.tail1234.ts.net
MEETOPS_APP_BASE_URL=https://meetops.<tailnet>.ts.net
MEETOPS_PUBLIC_API_URL=https://meetops.<tailnet>.ts.net
MEETOPS_CORS_ORIGINS=https://meetops.<tailnet>.ts.net

# --- Database ---
# Bundled: COMPOSE_PROFILES=db runs the postgres container; setup.sh fills both values below.
# External server: empty COMPOSE_PROFILES and point DATABASE_URL at it (UTF8 database owned by the role).
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://meetops:<POSTGRES_PASSWORD>@postgres:5432/meetops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Storage: recordings on this machine's disk (data/recordings/store) ---
MEETOPS_STORAGE_BACKEND=local
MEETOPS_DELETE_LOCAL_AFTER_UPLOAD=true
MEETOPS_STAGING_TTL_DAYS=7

# --- Auth ---
MEETOPS_SESSION_TTL_SECS=2592000
MEETOPS_SESSION_COOKIE_NAME=meetops_session
MEETOPS_SESSION_COOKIE_SAMESITE=lax
# Verification and password-reset emails need Resend below. Without it, leave this false so
# sign-ups work (the app is only reachable on your tailnet anyway).
MEETOPS_REQUIRE_EMAIL_VERIFICATION=false
MEETOPS_AUTH_RATE_LIMIT=10/minute

# --- Email (Resend, optional) ---
RESEND_API_KEY=
MEETOPS_EMAIL_FROM=
MEETOPS_EMAIL_FROM_NAME=MeetOps

# --- Google Calendar OAuth ---
# Register GOOGLE_REDIRECT_URI exactly in Google Cloud console -> Credentials -> your OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://meetops.<tailnet>.ts.net/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=https://meetops.<tailnet>.ts.net/app/calendars
MEETOPS_CALENDAR_SYNC_INTERVAL_SECS=300

# --- Crypto (generated by setup.sh) ---
MEETOPS_TOKEN_ENCRYPTION_KEY=

# --- Bot ---
MEETOPS_BOT_DISPLAY_NAME=MeetOps Notetaker
MEETOPS_BOT_CONCURRENCY=2
MEETOPS_BOT_JOIN_LEAD_TIME_SECS=60
MEETOPS_BOT_ADMISSION_TIMEOUT_SECS=300
MEETOPS_BOT_SCHEDULER_POLL_SECS=15
MEETOPS_BOT_SOLO_LEAVE_SECS=300
MEETOPS_BOT_ADHOC_DURATION_SECS=7200
MEETOPS_PATCHRIGHT_CHANNEL=bundled
MEETOPS_USE_TAB_CAPTURE_AUTO_ACCEPT=false
# noVNC password for the one-time bot sign-in (generated by setup.sh)
MEETOPS_VNC_PASSWORD=

# --- Transcription: Deepgram preferred, OpenAI Whisper fallback ---
MEETOPS_TRANSCRIBE_PROVIDER=auto
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest

# --- AI notes (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Observability ---
MEETOPS_LOG_LEVEL=INFO
MEETOPS_LOG_JSON=true
