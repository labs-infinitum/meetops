{
  "name": "@ai-meeting-notetaker/proto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared protobuf definitions and generated TypeScript clients for the notetaker API",
  "scripts": {
    "proto:generate": "mkdir -p src/gen && protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out ./src/gen --ts_opt generate_dependencies,ts_nocheck --proto_path . ./notetaker/v1/auth.proto ./notetaker/v1/calendar.proto ./notetaker/v1/meeting.proto ./notetaker/v1/recording.proto"
  },
  "exports": {
    "./notetaker/v1/auth": "./src/gen/notetaker/v1/auth.ts",
    "./notetaker/v1/auth.client": "./src/gen/notetaker/v1/auth.client.ts",
    "./notetaker/v1/calendar": "./src/gen/notetaker/v1/calendar.ts",
    "./notetaker/v1/calendar.client": "./src/gen/notetaker/v1/calendar.client.ts",
    "./notetaker/v1/meeting": "./src/gen/notetaker/v1/meeting.ts",
    "./notetaker/v1/meeting.client": "./src/gen/notetaker/v1/meeting.client.ts",
    "./notetaker/v1/recording": "./src/gen/notetaker/v1/recording.ts",
    "./notetaker/v1/recording.client": "./src/gen/notetaker/v1/recording.client.ts"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "typescript": "~6.0.2"
  }
}
